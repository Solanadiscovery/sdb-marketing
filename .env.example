# Serve solo per usare il programma dal PC (copialo in .env). Su GitHub si usano i segreti del repository.
# Mai condividere il file .env: niente segreti nel codice, nei log o in chat.
# --- Instagram ---
# Token: "Instagram Login" generato nella dashboard Meta (consigliato) oppure token della Pagina Facebook (EAA...).
IG_ACCESS_TOKEN=
# Solo con il token della Pagina Facebook: con Instagram Login l'ID si ricava dal token.
IG_USER_ID=
# Indirizzo pubblico di immagini e storie, senza barra finale.
MEDIA_BASE_URL=https://solanadiscovery.github.io/sdb-marketing
# --- Inserzioni a pagamento (facoltativo) ---
META_AD_ACCOUNT_ID=
META_ADS_TOKEN=
# Tetto di sicurezza: il programma rifiuta budget giornalieri più alti
MAX_DAILY_BUDGET_EUR=5
